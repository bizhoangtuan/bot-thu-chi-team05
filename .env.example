# ==== Zalo Bot ====
# Lấy từ Zalo OA "Zalo Bot Manager" sau khi tạo Bot Thu Chi Team 05
BOT_TOKEN=

# (Tuỳ chọn) Danh sách các cách gọi tên bot để nhận diện "tag", cách nhau bởi dấu phẩy.
# Mặc định đã có sẵn "bot thu - chi team 05" và biến thể không dấu gạch ngang.
BOT_MENTION_KEYWORDS=

# ==== OpenAI — dùng để đọc ảnh hoá đơn và trích xuất dữ liệu ====
OPENAI_API_KEY=
# Model dùng để đọc ảnh hoá đơn (mặc định gpt-4o-mini, có thể đổi thành gpt-4o để chính xác hơn)
OPENAI_MODEL=gpt-4o-mini

# ==== Google Sheets ====
# ID của Google Sheet (lấy từ URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=
# Tên tab/sheet để ghi dữ liệu
GOOGLE_SHEET_NAME=ThuChi

# Nội dung file JSON của Google Service Account, dán nguyên văn 1 dòng (xem hướng dẫn trong README)
GOOGLE_SERVICE_ACCOUNT_JSON=

PORT=3000
